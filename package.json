{
	"name": "aether-forms",
	"version": "0.0.1",
	"description": "Schema-first form system for Effect Schema and Svelte 5",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kareyes/aether-forms.git"
	},
	"homepage": "https://github.com/kareyes/aether-forms",
	"bugs": {
		"url": "https://github.com/kareyes/aether-forms/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"effect",
		"effect-schema",
		"forms",
		"schema-first",
		"validation"
	],
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build && bunx --bun svelte-package && bun run clean-dist",
		"package": "bunx --bun svelte-package && bun run clean-dist",
		"clean-dist": "bun scripts/clean-dist.js",
		"watch-package": "bunx --bun svelte-kit sync && bunx --bun svelte-package --watch",
		"preview": "bunx --bun vite preview",
		"prepare": "bunx --bun svelte-kit sync || echo ''",
		"check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test src/",
		"storybook": "bunx --bun storybook dev -p 6007",
		"build-storybook": "bunx --bun storybook build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.stories.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		}
	},
	"peerDependencies": {
		"aether-ui": "github:kareyes/aether-ui",
		"effect": "^3.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"aether-ui": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"dependencies": {
		"@internationalized/date": "^3.10.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.1",
		"@storybook/addon-a11y": "^9.1.10",
		"@storybook/addon-docs": "^9.1.10",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/sveltekit": "^9.1.10",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/bun": "latest",
		"@types/node": "^22",
		"effect": "^3.19.15",
		"storybook": "^9.1.10",
		"svelte": "^5.39.5",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	}
}
